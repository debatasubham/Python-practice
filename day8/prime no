print("welcome to prime number checker")
no = int(input("enter the number you want to check "))
def prime(no):
    if no <=1:
        print("not a prime")
        return
    prime = True
    for i in range(2,no-1):
        if no % i == 0:
            prime = False
    if prime:
        print(f"{no}  is a prime number")
    else:
        print(f"{no}  is not prime number")
prime(no)