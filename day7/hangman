import random
from replit import clear
word = ["subham", "satyam", "saroj", "aman", "susil", "suraj"]
ran_word = random.choice(word)
print(ran_word)
length = len(ran_word)

display=[]
for _ in range(length):
    display += "_"

end = False
lives=6
while not end:
    guess = input("guess a letter ?").lower()
    clear()
    if guess in display:
        print(f"you've already guessed {guess}")
    for position in range(length):
        letter = ran_word[position]
        if letter == guess:
            display[position] = letter
    
    if guess not in ran_word:
        print("you lose a life")
        lives -= 1
        if lives == 0:
            end = True
            print("you lose")
    print(f"{''.join(display)}")
    print(stages[lives])

    if "_" not in display:
        end = True
        print("you won")
    