print("welcome to true love calculator")
my= input("enter your name:")
their= input ("enter their name:")
ni = my.lower()
nu = their.lower()
name = ni + nu
t = name.count("t")
r = name.count("r")
u = name.count("u")
e = name.count("e")
true = t + r + u + e
l = name.count("l")
o = name.count("o")
v = name.count("v")
e = name.count("e")
love = l + o + v + e
true_love = str(true) + str(love)
score = int(true_love)
print(f"your percentage of true love is {true}{love}")
if score<10 or score>90:
    print(f"your score is {score}, you go together like coke and mentos")
elif score>40 and score<50:
    print(f"your score is {score}, you are alright together")
else:
    print(f"your score is {score}")
