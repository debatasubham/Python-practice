print("welcome to the tip calculator")
nbill = input("what is your total bill?")
bill = int(nbill)
ntip = input("what percentage tip would you like to give? 10,12 or 15 ?")
tip = int(ntip)
final_amt = float(bill+(bill*(tip/100)))
npeople = input("how many people to split the bill ?")
people = int(npeople)
paym = float(final_amt)/int(people)
print(f"each person should pay{paym} ")
